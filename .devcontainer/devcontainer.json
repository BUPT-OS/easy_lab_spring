{
  "name": "C++ Development Container",
  "dockerFile": "Dockerfile",

  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cpptools",
        "wayou.vscode-todo-highlight"
      ]
    }
  },
  "runArgs": [
    "--privileged",
    "--security-opt",
    "seccomp=unconfined",
    "--cap-add=SYS_PTRACE",
    "--cap-add=SYS_ADMIN"
  ]
}